{
  "name": "merchant-onboarding-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Merchant Onboarding Lab: interactive Tabby, Tamara, Madfu Current and Madfu Proposed onboarding experiences (mock data only).",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "build:pages": "tsc --noEmit -p tsconfig.json && LAB_BASE=/madfu-onboarding-lab/ vite build",
    "pdf": "node scripts/build-pdf.mjs",
    "docs": "node scripts/build-docs.mjs",
    "e2e": "playwright test",
    "serve:pages": "node scripts/serve-pages.mjs --port 4799 --base /madfu-onboarding-lab/"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
